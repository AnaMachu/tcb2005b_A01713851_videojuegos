<%- include('../include/_header') %>
 <h2>Tienda en Línea: PawFriend</h2>
  <p>Hola! Nuestros productos tienen las mejores ofertas para ti. Encuentra lo que necesitas.</p>

  <div class="Productos">

    <div class="caja">
      <h3>Bracalete de la amistad para mascota</h3>
      <p>Comparte un bracalete matching para reforzar el vínculo con tu mascota</p>
      <img src="/imagenes/frienshipbracelete.png" width="100" height="85">
      <div class="precio">$600</div>
      <label>Cantidad:</label>
      <div class="control-cantidad">
        <button onclick="cambiar('p1', -1)">−</button>
        <input type="number" id="qty-p1" value="0" min="0" max="10" oninput="actualizar()">
        <button onclick="cambiar('p1', 1)">+</button>
      </div>
      <span class="error" id="err-p1"></span>
    </div>

    <div class="caja">
      <h3>Sueter Navideño</h3>
      <p>Viste a tu mascota según la temporada invernal</p>
      <img src="/imagenes/sueternavidad.png" width="100" height="85">
      <div class="precio">$350</div>
      <label>Cantidad:</label>
      <div class="control-cantidad">
        <button onclick="cambiar('p2', -1)">−</button>
        <input type="number" id="qty-p2" value="0" min="0" max="10" oninput="actualizar()">
        <button onclick="cambiar('p2', 1)">+</button>
      </div>
      <span class="error" id="err-p2"></span>
    </div>

    <div class="caja">
      <h3>Bebedero/comedor inteligente</h3>
      <p>Que a tu mascota nunca le falten alimentos incluso si tu no estás.</p>
      <img src="/imagenes/bebdero.png" width="100" height="85">
      <div class="precio">$430</div>
      <label>Cantidad:</label>
      <div class="control-cantidad">
        <button onclick="cambiar('p3', -1)">−</button>
        <input type="number" id="qty-p3" value="0" min="0" max="10" oninput="actualizar()">
        <button onclick="cambiar('p3', 1)">+</button>
      </div>
      <span class="error" id="err-p3"></span>
    </div>

    <div class="caja">
      <h3>Cobija con cara de mascota</h3>
      <p>Personaliza una frazada para compartirla con tu peludo</p>
      <img src="/imagenes/cobijamascot.png" width="100" height="85">
      <div class="precio">$700</div>
      <label>Cantidad:</label>
      <div class="control-cantidad">
        <button onclick="cambiar('p4', -1)">−</button>
        <input type="number" id="qty-p4" value="0" min="0" max="10" oninput="actualizar()">
        <button onclick="cambiar('p4', 1)">+</button>
      </div>
      <span class="error" id="err-p4"></span>
    </div>

  </div>

  
  <div class="Resumen">
    <h3>Resumen</h3>
    <p>Bracalete: <span id="sum-p1">0 unidades — $0</span></p>
    <p>Sueter: <span id="sum-p2">0 unidades — $0</span></p>
    <p>Bebedero: <span id="sum-p3">0 unidades — $0</span></p>
    <p>Cobija: <span id="sum-p4">0 unidades — $0</span></p>
    <hr>
    <p>Subtotal: <strong id="subtotal">$0</strong></p>
    <p>IVA (16%): <strong id="iva">$0</strong></p>
    <p>Total: <strong id="total">$0</strong></p>
    <button class="comprar" id="btn-comprar" disabled onclick="confirmar()">Comprar</button>
  </div>

  <script src="/lab6.js"></script>

<%- include('../include/_footer') %>