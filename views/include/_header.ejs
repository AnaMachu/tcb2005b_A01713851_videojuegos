<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>PawFriend</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css">
</head>
<body>
<nav class="navbar is-dark">
  <div class="navbar-brand">
    <a class="navbar-item has-text-white" href="/mod213/tienda">PawFriend</a>
  </div>
  <div class="navbar-menu">
    <div class="navbar-start">
      <a class="navbar-item" href="/mod213/contacto">Acerca de mi</a>
      <a class="navbar-item" href="/lab13/razas">Razas de Perros</a>
      <a class="navbar-item" href="/mod213/preguntas">FAQs</a>
    </div>
  </div>
  
  <div class="navbar-end">
          <div class="navbar-item">
            <div class="buttons">
              <% if (typeof(username) != "undefined") { %>
                <a class="button is-light" href="/users/logout">
                  Log out
                </a>
              <% } else { %>
                <a class="button is-light" href="/users/login">
                  Log in
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    
</nav>
<section class="section">
      <div class="container">
        <p class="subtitle">
          <% if (typeof(username) != "undefined") { %>
            Hola <strong><%= username %></strong>!
          <% } %>
          </p>